config_version=5

[application]
config/name="StarSea"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
InputSetup="*res://scripts/core/input_setup.gd"
GameSettings="*res://scripts/core/game_settings.gd"
Verify="*res://scripts/verify/verify.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[shader_globals]
sky_up={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
surface_sky={
"type": "float",
"value": 0.0
}
sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
star_visibility={
"type": "float",
"value": 1.0
}
rim_strength={
"type": "float",
"value": 0.04
}
